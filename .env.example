# BorderMesh Configuration
PROJECT_NAME="BorderMesh — AI-Based Fake Identity & Document Screening System"
ENVIRONMENT="development"
DEMO_MODE=true

# Database (PostgreSQL with automatic SQLite fallback for zero-friction local run)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bordermesh"
# If running without local postgres, SQLite fallback URL:
# DATABASE_URL="sqlite:///./border_mesh.db"

# Storage
UPLOAD_DIR="./uploads"

# API & Security
SECRET_KEY="bordermesh-sih2026-demo-secret-key-change-in-production"
ALLOWED_HOSTS=["*"]

# Risk Engine Configurable Weights (Must sum to 1.0)
WEIGHT_MRZ=0.25
WEIGHT_TAMPER=0.30
WEIGHT_FACE=0.30
WEIGHT_CONSISTENCY=0.10
WEIGHT_WATCHLIST=0.05

# Risk Level Thresholds
THRESHOLD_LOW=24
THRESHOLD_MEDIUM=49
THRESHOLD_HIGH=74
# 75-100 is CRITICAL

# OCR Engine
OCR_ENGINE="pytesseract" # options: pytesseract, mock
TESSERACT_PATH="/opt/homebrew/bin/tesseract"
